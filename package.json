{
  "name": "craft-inventory-erp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Inventory Management Tool with Multi-Level BOM for handicraft manufacturing (brass/aluminium/iron/ceramic lamps & decor)",
  "main": "server/index.js",
  "scripts": {
    "start": "npm run build && node server/index.js",
    "build": "vite build --config client/vite.config.js",
    "dev": "concurrently -k \"vite --config client/vite.config.js\" \"node server/index.js\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "db:seed": "node server/seed.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.11"
  }
}
